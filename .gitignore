# macOS / Python noise
.DS_Store
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# The root assets/ is the workshop, none of it committed; mascot/sets/<name>/
# is the shipped goods. An overlay's own art -- its socials icons included
# (docs/adr/0012) -- is in overlays/<name>/assets/ and IS committed.
#
# Everything under the root assets/ is generated or scratch -- the camera LUTs
# tools/cam-grade.py writes to assets/luts/, the PNG socials renders, and the
# input and scratch for tools/hero-asset.py: the plate, the 80-odd scrub
# stills you flick through to find the loop points, the per-frame cells, the
# contact sheets, and a copy of the finished sheet. About 390 MB of it for the
# deer, none of it needed to run an overlay, and all of it reproducible from
# the set's source/ plus the command in the README.
#
# What ships is mascot/sets/<name>/{sheet.webp,manifest.json} -- the pair
# mascot.html actually loads. Building a new sprite set means copying those
# two out of the workshop into mascot/sets/<name>/.
#
# mascot/sets/<name>/source/ IS committed. It holds the inputs no command can
# regenerate: a prompt does not reproduce an image generator's output, and the
# video is a one-off render. ~18 MB for the deer, to never have to recreate
# the character. Everything derived from them stays out.
#
# `/assets/`, not `assets/`: without the leading slash the pattern matches a
# directory of that name at any depth, and would silently drop every
# overlay's own assets/ with it.
/assets/

# The uncompressed sheet is a fallback nothing loads: mascot.html reads `sheet`
# out of manifest.json, which names the webp. 9 MB for a spare.
mascot/sets/*/sheet.png

# chat/ is the one part of the repo with pip dependencies -- Piper and its
# onnxruntime -- so it carries its own venv, and tools/ stays standard library.
# Voices are ~60 MB of model each, fetched from Hugging Face, never committed.
chat/.venv/
chat/voices/

# The TTS blocklist is personal, and it is a list of slurs -- not something to
# publish with the repo. It is also the one chat file nothing can regenerate,
# so copy it by hand when you move machines; the bridge refuses to read chat
# aloud without it, and start.py and obs-setup.py --check both say so.
chat/blocklist.txt

# Local-only Claude Code settings
.claude/settings.local.json

# Working copies. Rename to something meaningful if you want one committed.
*copy.html

# overlays/*/obs/scenes.json IS committed on purpose -- it is the sanitised
# export from `obs-setup.py --export`. Never commit a collection straight out of
# ~/Library/Application Support/obs-studio: OBS stores browser URLs verbatim,
# so the raw file carries the websocket password and your home path.
basic/scenes/
*.json.bak
